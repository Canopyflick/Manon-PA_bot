# .env.example
# DEV or PROD mode
ENV_MODE=dev

# Telegram
TELEGRAM_API_KEY=xyz

# OpenAI
OPENAI_API_KEY=xyz
EC_OPENAI_API_KEY=xyz

# OpenRouter (LLMs + voice via mistralai/voxtral-small-24b-2507-stt)
OPENROUTER_API_KEY=xyz

# PostgreSQL (used by Dockerized DB)
DATABASE_URL=postgresql://manon:supersecret@postgres:5432/manon_db?timezone=Europe/Berlin

# Goals API (manon_api container). Bot ignores these.
SUPABASE_URL=https://ydoxkioiprlnqawdweol.supabase.co
# Publishable key. This project's user tokens are still HS256, and its JWKS is empty,
# so the API asks Supabase Auth /user to validate them.
SUPABASE_ANON_KEY=sb_publishable_replace_me
GOALS_API_CORS_ORIGINS=https://bentijd.lovable.app,http://localhost:8080,http://127.0.0.1:8080
GOALS_API_PORT=8000

# LangChain
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=xyz
LANGCHAIN_PROJECT=name

# Custom user IDs (comma-separated)
APPROVED_USER_IDS=123,456
BEN_ID=123
